```python
import numpy as np

def snv_transform(X: np.ndarray) -> np.ndarray:
    """
    Apply Standard Normal Variate (SNV) transformation to a 2D array.

    Each row (spectrum) is centered by subtracting its mean and scaled by 
    dividing by its standard deviation.

    Args:
        X: Input array of shape (n_samples, n_wavelengths).

    Returns:
        The SNV-transformed array of the same shape as X.
    """
    means = np.mean(X, axis=1, keepdims=True)
    stds = np.std(X, axis=1, keepdims=True)
    return (X - means) / stds
```

