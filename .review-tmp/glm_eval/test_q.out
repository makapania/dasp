```python
import numpy as np
import pytest
from numpy.testing import assert_allclose
from spectral_predict.contamination import one_class_metrics


EXPECTED_KEYS = {
    "sensitivity", "specificity", "precision", "f1", 
    "accuracy", "balanced_accuracy", "auc"
}


def test_all_correct_predictions():
    y_true = [1, 1, -1, -1]
    y_pred = [1, 1, -1, -1]
    result = one_class_metrics(y_true, y_pred)
    
    assert result.keys() == EXPECTED_KEYS
    assert_allclose(result["sensitivity"], 1.0)
    assert_allclose(result["specificity"], 1.0)
    assert_allclose(result["precision"], 1.0)
    assert_allclose(result["f1"], 1.0)
    assert_allclose(result["accuracy"], 1.0)
    assert_allclose(result["balanced_accuracy"], 1.0)
    assert np.isnan(result["auc"])


def test_all_wrong_predictions():
    y_true = [1, 1, -1, -1]
    y_pred = [-1, -1, 1, 1]
    result = one_class_metrics(y_true, y_pred)
    
    assert result.keys() == EXPECTED_KEYS
    assert_allclose(result["sensitivity"], 0.0)
    assert_allclose(result["specificity"], 0.0)
    assert_allclose(result["precision"], 0.0)
    assert_allclose(result["f1"], 0.0)
    assert_allclose(result["accuracy"], 0.0)
    assert_allclose(result["balanced_accuracy"], 0.0)
    assert np.isnan(result["auc"])


def test_only_inliers():
    y_true = [1, 1, 1, 1]
    y_pred = [1, -1, 1, -1]
    result = one_class_metrics(y_true, y_pred)
    
    assert result.keys() == EXPECTED_KEYS
    assert np.isnan(result["sensitivity"])
    assert_allclose(result["specificity"], 0.5)
    assert np.isnan(result["balanced_accuracy"])
    assert np.isnan(result["auc"])


def test_only_outliers():
    y_true = [-1, -1, -1, -1]
    y_pred = [-1, 1, -1, 1]
    result = one_class_metrics(y_true, y_pred)
    
    assert result.keys() == EXPECTED_KEYS
    assert_allclose(result["sensitivity"], 0.5)
    assert np.isnan(result["specificity"])
    assert np.isnan(result["balanced_accuracy"])
    assert np.isnan(result["auc"])


@pytest.mark.parametrize(
    "scores, expected_auc", 
    [
        pytest.param(None, np.nan, id="auc_scores_None"),
        pytest.param([0.1, -0.2, 0.3, -0.4], 1.0, id="auc_scores_provided"),
    ]
)
def test_auc(scores, expected_auc):
    y_true = [1, 1, -1, -1]
    y_pred = [1, 1, -1, -1]
    result = one_class_metrics(y_true, y_pred, scores=scores)
    
    if np.isnan(expected_auc):
        assert np.isnan(result["auc"])
    else:
        assert_allclose(result["auc"], expected_auc)
