+  # ignores the sampler kwarg on existing studies — DO NOT use that pattern.
+  return optuna.load_study(
+      study_name=study_name,
+      storage=sqlite_url,
+      sampler=TPESampler(
+          seed=random_state,
+          n_startup_trials=20,
+          n_ei_candidates=32,
+          multivariate=True,
