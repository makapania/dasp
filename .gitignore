# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
# Glob, not an enumeration: per-interpreter venvs (.venv312, .venv314, ...) come
# and go with Python upgrades, and listing them one by one silently fails to
# ignore the next one.
.venv*/
venv/
ENV/
env/

# Project specific
outputs/
reports/
artifacts/
!docs/plans/artifacts/
data/

# Review-helper scratch — patches, diffs, agent transcripts that
# accumulate during cross-family review dispatch. Never commit.
.review-tmp/

# Stray Windows-encoded tempfile names (legacy artifact, see e.g.
# CUsersmsponAppDataLocalTempopencodesearch_t30.py from earlier sessions).
# NB: git does not decode the \357\200\272 octal escapes that `git status`
# prints, so the pattern has to glob around the mangled separator.
C*Users*AppData*Temp*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build
*.egg-info/
dist/
build/

# Archive folder (local holding pen for clutter)
archive/
_archive/

# Test outputs and coverage dumps
test_output*.txt
test_results*.txt
coverage_report*.txt
profile.stats
*.log

# CatBoost training artifacts
catboost_info/

# Claude Code session artifacts
tmpclaude-*/
nul
.worktrees/
.claude/scheduled_tasks.lock

# One-off outputs
*.stats
.codex-gitconfig

# AI assistant temp files
.opencode-prompts/

# Crash dumps
bash.exe.stackdump

# One-off benchmark / comparison scripts (not part of test suite)
tests/_bench_*.py
tests/_compare_*

# Local reference data
reftir/

# Binary model files (generated artifacts)
*.dasp

# Pytest scratch trees from parallel/targeted runs
.pytest-tmp*/
.pytest_tmp/

# Scratch A/B results, repro scripts and review prompts produced during
# investigation. The underscore prefix marks them as non-deliverable.
tools/_*
!tools/_autoscale_bayes_compare_full.json

# Test-failure snapshots captured for branch-vs-main diffing
*_fails.txt
merge_gate_diff.json

# Live-GUI smoke screenshots
live_gui_*

# Per-machine Codex git identity
.gitconfig-codex

# Timestamped Colab notebook exports (regenerate from the generator)
example/colab_*.ipynb
